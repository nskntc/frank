# Copie para .env e preencha. O .env nunca entra no git.

# Aviso no celular: crie um bot no BotFather do Telegram e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Seu chat com o bot (o Frank mostra como descobrir na tela de Configuracoes)
TELEGRAM_CHAT_ID=

# Opcional: preco em cada vendedor e historico de 60 dias da rota, via Google Flights.
# Chave gratis em serpapi.com (250 consultas/mes). Sem ela, o Frank mostra links de busca.
SERPAPI_API_KEY=
