# Copie para .env e preencha. O .env nunca entra no git.

# --- Avisos (pelo menos um canal) ---

# E-mail pela sua propria conta, para voce mesmo. Gmail: smtp.gmail.com, porta 465 e uma
# "senha de app" (myaccount.google.com > Seguranca > Senhas de app; exige verificacao em duas
# etapas). Teste com: pnpm --filter @frank/vigia testar-aviso
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
ALERTA_EMAIL_PARA=

# Telegram (opcional, gratis): crie um bot no BotFather e mande uma mensagem a ele
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcional ---

# Preco em cada vendedor e historico de 60 dias da rota, via Google Flights.
# Chave gratis em serpapi.com (250 consultas/mes). Sem ela, o Frank mostra links de busca.
SERPAPI_API_KEY=

# Modelo do Claude (vazio = o padrao do seu plano) e limites
FRANK_MODELO=
FRANK_LIMITE_DIARIO_IA=30
FRANK_TETO_DIARIO_FONTE=300
FRANK_TETO_MENSAL_SERPAPI=240
