{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(sftp *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env.production*)",
      "Edit(**/.env.production*)",
      "Edit(/.claude/hooks/secret-guard-permitidos.txt)",
      "Bash(git *push* --force*)",
      "Bash(git *push* -f)",
      "Bash(git *push* -f *)",
      "Bash(git *--no-verify*)",
      "PowerShell(git *push* --force*)",
      "PowerShell(git *push* -f)",
      "PowerShell(git *push* -f *)",
      "PowerShell(git *--no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-guard.sh",
            "timeout": 60,
            "statusMessage": "secret-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 60,
            "statusMessage": "stop-check"
          }
        ]
      }
    ]
  }
}
